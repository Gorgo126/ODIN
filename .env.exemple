HTTP_PORT=80
DATA_DIR=./data
COMPOSE_PROJECT_NAME=odin
# Sonde de la liaison monde : cibles TCP 443 et domaine à résoudre
LIAISON_CIBLES=1.1.1.1,9.9.9.9,8.8.8.8
LIAISON_DNS=wikipedia.org
# Recherche avancée : modèle de vecteurs (fichier servi par llama.cpp, téléchargé et vérifié par install.sh)
MODELE_EMBEDDING=embeddinggemma:300m
MODELE_VECTEURS=embeddinggemma-300M-Q8_0.gguf
# Traduction hors ligne : langues de la première installation (ensuite, packs de langues dans ODIN,
# page Configuration) et taille maximale d'un texte, en caractères
TRADUCTION_LANGUES=fr,en
TRADUCTION_LIMITE=5000
# Point d'accès Wi-Fi (option, non vérifiée sur du vrai matériel) : 1 = ODIN crée son propre réseau
# Wi-Fi. Écrit par l'installeur (sudo POINT_ACCES=1 bash), gardé aux mises à jour.
POINT_ACCES=0
# Interface imposée (vide = détection), nom du réseau, adresse d'ODIN sur ce réseau et masque,
# code pays réglementaire (vide = déduit du fuseau horaire)
POINT_ACCES_INTERFACE=
POINT_ACCES_SSID=ODIN
POINT_ACCES_RESEAU=10.42.0.1/24
PAYS=
