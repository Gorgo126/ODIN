{
	auto_https off
}

(protege) {
	forward_auth dashboard:3000 {
		uri /api/auth/verifier
		header_up -Connection
		header_up -Upgrade
	}
}

:80 {
	@public path /connexion /connexion/* /api/auth/* /_next/* /favicon.ico /logo.png
	handle @public {
		reverse_proxy dashboard:3000
	}

	handle /documents* {
		import protege
		reverse_proxy filebrowser:80
	}

	handle /kiwix* {
		import protege
		reverse_proxy kiwix:8080
	}

	# Map packs (PMTiles), read by the browser with Range requests
	handle /tuiles/* {
		import protege
		uri strip_prefix /tuiles
		root * /srv/cartes
		file_server
	}

	# Book PDFs, read by the viewer with Range requests. Only <id>/document.pdf is served:
	# never fiche.json, a download in progress (.en-cours) or anything else of data/livres.
	handle /livres-fichiers/* {
		import protege
		@pdf path_regexp ^/livres-fichiers/[a-z0-9]+(-[a-z0-9]+)*/document\.pdf$
		handle @pdf {
			uri strip_prefix /livres-fichiers
			root * /srv/livres
			file_server
		}
		respond 404
	}

	# Personal documents opened from the assistant's sources (PDFs in the viewer, Range requests).
	# Read-only, and sandboxed: an HTML document can neither run scripts nor act as ODIN.
	handle /fichiers-documents/* {
		import protege
		uri strip_prefix /fichiers-documents
		root * /srv/documents
		header Content-Security-Policy "sandbox"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle {
		import protege
		reverse_proxy dashboard:3000
	}
}
